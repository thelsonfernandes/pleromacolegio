# TurboCloud (Apache/LiteSpeed) — páginas HTML estáticas do Colégio Pleroma.
# Publique este arquivo junto ao conteúdo gerado em dist/.

Options -MultiViews
DirectoryIndex index.html

RewriteEngine On

# Consolida HTTPS e o domínio sem www.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^colegiopleroma\.com\.br$ [NC]
RewriteRule ^ https://colegiopleroma.com.br%{REQUEST_URI} [R=301,L]

# Remove index.html, extensões .html e barras finais das URLs públicas.
RewriteCond %{THE_REQUEST} \s/+index\.html[?\s] [NC]
RewriteRule ^index\.html$ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[?\s] [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L]
RewriteCond %{THE_REQUEST} \s/+(.+?)/[?\s] [NC]
RewriteRule ^(.+)/$ /$1 [R=301,L]

# A antiga rota /home é consolidada na URL canônica da página inicial.
RewriteRule ^home/?$ / [R=301,L]

# Serve /sobre a partir de sobre.html e preserva a URL pública sem extensão.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# URLs inexistentes retornam um 404 verdadeiro, sem carregar a Home.
ErrorDocument 404 /404.html
